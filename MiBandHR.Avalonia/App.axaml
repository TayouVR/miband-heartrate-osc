<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiBandHR.Avalonia.App"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <!-- Supply templates for controls not covered by FluentAvalonia, such as TableView. -->
        <FluentTheme />
        <styling:FluentAvaloniaTheme />
        <Style Selector="TableViewRow">
            <Setter Property="Padding" Value="4"></Setter>
        </Style>
        <Style Selector="TableViewCell">
            <Setter Property="Padding" Value="6 0 0 0"></Setter>
        </Style>
    </Application.Styles>
</Application>