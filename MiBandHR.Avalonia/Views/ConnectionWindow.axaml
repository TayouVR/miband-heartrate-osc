<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiBandHR.Avalonia.ViewModels"
        xmlns:ble="using:MiBandHR.Core.Bluetooth"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiBandHR.Avalonia.Views.ConnectionWindow"
        x:DataType="vm:ConnectionViewModel"
        Icon="/Assets/icon.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Title="Heartrate Monitor - Connection">

    <Design.DataContext>
        <vm:ConnectionViewModel />
    </Design.DataContext>

    <StackPanel Margin="10" MinWidth="380">
        <Grid ColumnDefinitions="*, Auto" Margin="0 0 0 5">
            <TextBlock Grid.Column="0" VerticalAlignment="Center">Select your device</TextBlock>
            <Button Grid.Column="1" Content="Refresh" Padding="10 3"
                    Command="{Binding CommandRefresh}" />
        </Grid>

        <Grid MinHeight="120" Margin="0 0 0 10">
            <ListBox ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice}"
                     HorizontalAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="ble:IBluetoothDevice">
                        <TextBlock Text="{Binding Name}" Padding="5" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding IsScanning}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="5">
                <ProgressBar IsIndeterminate="True" Width="120" />
                <TextBlock Text="Scanning..." HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ScanStatus}" Margin="0 0 0 10"
                   TextWrapping="Wrap" />

        <Grid ColumnDefinitions="150, *" Margin="0 0 0 10">
            <TextBlock Grid.Column="0" VerticalAlignment="Center">Select the model</TextBlock>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding DeviceModels}"
                      SelectedItem="{Binding SelectedModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:DeviceModelOption">
                        <TextBlock Text="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Separator />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" Padding="10 5" Margin="5 10 5 5"
                    Command="{Binding CommandCancel}" />
            <Button Content="Connect" Padding="10 5" Margin="5 10 5 5"
                    Command="{Binding CommandConnect}" />
        </StackPanel>
    </StackPanel>
</Window>