<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiBandHR.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiBandHR.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        Icon="/Assets/icon.ico"
        Width="760" Height="460"
        MinWidth="760" MinHeight="460"
        Title="Heartrate Monitor">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="420, *">

        <!-- Left: main content -->
        <StackPanel Grid.Column="0">
            <Grid Margin="5" VerticalAlignment="Top" ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                    <StackPanel Orientation="Horizontal"
                                IsVisible="{Binding ShowConnectButtons}">
                        <Button Content="Manual Connect" Padding="10 5" Margin="5 5 0 5" Height="32"
                                Command="{Binding CommandConnect}"
                                IsVisible="{Binding !UseAutoConnect}" />
                        <Button Content="Auto Connect" Padding="10 5" Margin="5 5 0 5" Height="32"
                                Command="{Binding CommandAutoConnect}"
                                IsVisible="{Binding UseAutoConnect}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                IsVisible="{Binding IsConnected}">
                        <Button Content="Disconnect" Padding="10 5" Margin="5 5 0 5" Height="32"
                                Command="{Binding CommandDisconnect}" />
                    </StackPanel>

                    <Button Margin="5 5 0 5" Height="32" Width="32"
                            Command="{Binding CommandSettings}"
                            ToolTip.Tip="Settings">
                        <ui:FASymbolIcon Symbol="Settings" FontSize="16" Height="16" Width="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <HeaderedContentControl Header="Heartrate" Margin="5">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontSize="32" Margin="0 10" VerticalAlignment="Center"
                                   Text="{Binding Device.Heartrate, TargetNullValue=--, FallbackValue=--}" />
                        <TextBlock FontSize="32" Margin="0 10" VerticalAlignment="Center">bpm</TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">Min: </TextBlock>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Device.MinHeartrate, TargetNullValue=--, FallbackValue=--}" />
                        <TextBlock VerticalAlignment="Center"> bpm&#160;&#160;Max: </TextBlock>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Device.MaxHeartrate, TargetNullValue=--, FallbackValue=--}" />
                        <TextBlock VerticalAlignment="Center"> bpm</TextBlock>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <Grid Height="40" Margin="0 15 0 10" ColumnDefinitions="*, *">
                <Button Content="Start" Grid.Column="0" Margin="5 0"
                        Command="{Binding CommandStart}" />
                <Button Content="Stop" Grid.Column="1" Margin="5 0"
                        Command="{Binding CommandStop}" />
            </Grid>
        </StackPanel>

        <!-- Right: Bluetooth activity log -->
        <HeaderedContentControl Grid.Column="1" Header="Bluetooth Log" Margin="5">
            <ListBox x:Name="LogList"
                     ItemsSource="{Binding LogEntries}"
                     Background="#1E1E1E"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntryViewModel">
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{Binding Foreground}"
                                   FontFamily="Consolas, Menlo, Monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </HeaderedContentControl>
    </Grid>
</Window>