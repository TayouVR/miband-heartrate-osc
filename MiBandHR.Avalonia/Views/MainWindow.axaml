<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiBandHR.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiBandHR.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:controls="using:MiBandHR.Avalonia.Controls"
        Icon="/Assets/icon.ico"
        Width="440" Height="220"
        MinWidth="380" MinHeight="200"
        SizeToContent="Height"
        CanResize="True"
        Title="Heartrate Monitor">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="10">
        <Grid VerticalAlignment="Top" ColumnDefinitions="*, Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                <StackPanel Orientation="Horizontal"
                            IsVisible="{Binding ShowConnectButtons}">
                    <Button Content="Manual Connect" Padding="10 5" Margin="5 0 0 0" Height="32"
                            Command="{Binding CommandConnect}"
                            IsVisible="{Binding !UseAutoConnect}" />
                    <Button Content="Auto Connect" Padding="10 5" Margin="5 0 0 0" Height="32"
                            Command="{Binding CommandAutoConnect}"
                            IsVisible="{Binding UseAutoConnect}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            IsVisible="{Binding IsConnected}">
                    <Button Content="Disconnect" Padding="10 5" Margin="5 0 0 0" Height="32"
                            Command="{Binding CommandDisconnect}" />
                </StackPanel>

                <Button Margin="5 0 0 0" Height="32" Width="32"
                        Command="{Binding CommandLog}"
                        ToolTip.Tip="Bluetooth Log">
                    <ui:FASymbolIcon Symbol="Document" FontSize="16" Height="16" Width="16" />
                </Button>

                <Button Margin="5 0 0 0" Height="32" Width="32"
                        Command="{Binding CommandSettings}"
                        ToolTip.Tip="Settings">
                    <ui:FASymbolIcon Symbol="Settings" FontSize="16" Height="16" Width="16" />
                </Button>
            </StackPanel>
        </Grid>

        <HeaderedContentControl Header="Heartrate" Margin="0 10 0 0">
            <Panel>
                <controls:SparklineControl Points="{Binding HeartrateHistory}"
                                           Opacity="0.45"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch" />

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                IsVisible="{Binding HasHeartrate}">
                        <TextBlock FontSize="32" Margin="0 5" VerticalAlignment="Center"
                                   Text="{Binding Device.Heartrate}" />
                        <TextBlock FontSize="32" Margin="0 5" VerticalAlignment="Center">&#160;bpm</TextBlock>
                    </StackPanel>
                    <TextBlock FontSize="20" Margin="0 11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Medium"
                               IsVisible="{Binding !HasHeartrate}"
                               Text="{Binding HeartrateStatusText}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">Min: </TextBlock>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Device.MinHeartrate, TargetNullValue=--, FallbackValue=--}" />
                        <TextBlock VerticalAlignment="Center"> bpm&#160;&#160;Max: </TextBlock>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Device.MaxHeartrate, TargetNullValue=--, FallbackValue=--}" />
                        <TextBlock VerticalAlignment="Center"> bpm</TextBlock>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </HeaderedContentControl>

        <Grid Height="40" Margin="0 15 0 0" ColumnDefinitions="*, *">
            <Button Content="Start" Grid.Column="0" Margin="0 0 5 0"
                    Command="{Binding CommandStart}" />
            <Button Content="Stop" Grid.Column="1" Margin="5 0 0 0"
                    Command="{Binding CommandStop}" />
        </Grid>
    </StackPanel>
</Window>