<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiBandHR.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiBandHR.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/icon.ico"
        Width="580"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Heartrate Monitor - Settings">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="10">
            <!-- General & Connection Options -->
            <HeaderedContentControl Header="Options" Margin="5">
                <StackPanel Margin="5" Spacing="4">
                    <CheckBox Margin="0 2" IsChecked="{Binding UseAutoConnect}">Use Auto Connect</CheckBox>
                    <CheckBox Margin="0 2" IsChecked="{Binding TryConnectOnStartup}">Auto start heartrate monitor on application startup</CheckBox>
                    <CheckBox Margin="0 2" IsChecked="{Binding ContinuousMode}">Enable continuous mode</CheckBox>
                    <CheckBox Margin="0 2" IsChecked="{Binding EnableCsvOutput}">Export data in CSV file</CheckBox>
                    <CheckBox Margin="0 2" IsChecked="{Binding EnableFileOutput}">Write realtime data in text file</CheckBox>
                    <CheckBox Margin="0 2" IsChecked="{Binding EnableOscOutput}">Send OSC to VRChat</CheckBox>

                    <Grid Margin="0 6 0 2" ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center">Bluetooth backend</TextBlock>
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailableBackends}"
                                  SelectedItem="{Binding SelectedBluetoothBackend}" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <!-- MiBand 4/5 Authentication Key -->
            <HeaderedContentControl Header="Mi Band 4/5 Authentication" Margin="5">
                <StackPanel Margin="5" Spacing="6">
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center">Auth Key</TextBlock>
                        <TextBox Grid.Column="1"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding MiBand4AuthKey}"
                                 PlaceholderText="0123456789abcdef0123456789abcdef" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <!-- Remembered Authenticated Devices (Mi Band 2/3) -->
            <HeaderedContentControl Header="Remembered Authenticated Devices" Margin="5">
                <StackPanel Margin="5" Spacing="8">
                    <!-- Table Header -->
                    <Border Background="#252525" CornerRadius="4" Padding="8 4">
                        <Grid ColumnDefinitions="*, *, 60">
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Device Address / ID" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Authentication Key" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Action" />
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding AuthKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AuthKeyEntryViewModel">
                                <Border BorderBrush="#333333" BorderThickness="0 0 0 1" Padding="4 2">
                                    <Grid ColumnDefinitions="*, *, 60" Margin="0 2">
                                        <TextBox Grid.Column="0"
                                                 Margin="0 0 4 0"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding DeviceId}" />
                                        <TextBox Grid.Column="1"
                                                 Margin="0 0 4 0"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding AuthKey}" />
                                        <Button Grid.Column="2"
                                                Content="Remove"
                                                Padding="4 2"
                                                HorizontalAlignment="Center"
                                                Command="{Binding CommandRemove}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No remembered devices."
                               FontStyle="Italic"
                               Foreground="#888888"
                               Margin="4 2"
                               IsVisible="{Binding !AuthKeys.Count}" />

                    <!-- Add New Device Row -->
                    <Border Background="#1E1E1E" CornerRadius="4" Padding="6" Margin="0 4 0 0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Add Device Manually" FontWeight="SemiBold" FontSize="12" />
                            <Grid ColumnDefinitions="*, *, Auto">
                                <TextBox Grid.Column="0"
                                         Margin="0 0 4 0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding NewDeviceId}"
                                         PlaceholderText="Device ID / Address" />
                                <TextBox Grid.Column="1"
                                         Margin="0 0 4 0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding NewAuthKey}"
                                         PlaceholderText="Auth Key (Hex)" />
                                <Button Grid.Column="2"
                                        Content="Add"
                                        Padding="12 4"
                                        Command="{Binding CommandAddDevice}" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       Text="{Binding AddErrorText}"
                                       FontSize="12"
                                       IsVisible="{Binding HasAddError}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <Separator Margin="0 5 0 0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Close" Padding="20 5" Margin="5 5 5 5"
                        Command="{Binding CommandClose}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
