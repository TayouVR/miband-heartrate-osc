<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiBandHR.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MiBandHR.Avalonia.Views.LogWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Width="520" Height="400"
        MinWidth="360" MinHeight="240"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Heartrate Monitor - Bluetooth Log">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="4" RowDefinitions="*, Auto">
        <Border Grid.Row="0"
                Background="#1E1E1E"
                CornerRadius="4"
                ClipToBounds="True">
            <ScrollViewer x:Name="LogScrollViewer"
                          Padding="4"
                          HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock x:Name="LogText"
                                     FontFamily="Consolas, Menlo, Monospace"
                                     FontSize="12"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="0 4 0 0" ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0"
                    Content="Clear"
                    Padding="15 5"
                    Command="{Binding CommandClearLog}" />

            <Button Grid.Column="2"
                    Content="Close"
                    Padding="20 5"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
